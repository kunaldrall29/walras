{
  "name": "walras",
  "version": "0.1.0",
  "private": true,
  "description": "A Stellar x402 facilitator + Bazaar discovery layer",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run check:deps && pnpm -r test",
    "check:deps": "node scripts/check-single-stellar-sdk.mjs",
    "check:licenses": "node scripts/license-scan.mjs",
    "preflight": "node scripts/preflight.mjs",
    "fixtures": "node scripts/build-fixtures.mjs",
    "dev:facilitator": "pnpm --filter @walras/facilitator dev",
    "eval:search": "pnpm --filter @walras/bazaar build && node eval/search/run.mjs",
    "docs:gen": "node scripts/docs/gen.mjs",
    "docs:check": "node scripts/docs/check.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@redocly/cli": "^2.44.2",
    "@stellar/stellar-sdk": "^16.2.0",
    "@walras/bazaar": "workspace:*",
    "@x402/extensions": "2.20.0",
    "markdown-it": "^15.0.0",
    "markdown-link-check": "^3.15.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
