# walras — testnet configuration template.
# Copy to .env and fill in. .env is gitignored; never commit secrets, even testnet ones.
# Regenerate accounts with: node scripts/setup-accounts.mjs

# --- Network (FACTS F-004) ---
NETWORK=stellar:testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# --- Payment asset (FACTS F-052, verified on-chain) ---
# SEP-41 Soroban token contract. Classic assets are NOT supported (FACTS F-033).
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Facilitator submitter (required) ---
# The account that sources settlement transactions and sponsors their fees. Needs XLM
# only; it never holds the payment asset, so it needs no trustline (FACTS F-006).
# Accepts one seed, or a comma-separated list to run several submitters under the
# package's round-robin selection (DECISIONS D-012).
# Left commented so the placeholder can never shadow the value you paste from
# scripts/setup-accounts.mjs (every consumer prefers SUBMITTER_SECRET over the alias).
# SUBMITTER_SECRET=S...
# Optional dedicated fee account. When set, settlement is wrapped in a fee-bump
# transaction, decoupling fee payment from sequence-number management — which is how the
# reference operator runs in production (FACTS F-055, DECISIONS D-012).
# FEE_BUMP_SECRET=S...

# --- Other accounts (names match the x402 e2e suite, FACTS F-056) ---
# FACILITATOR_STELLAR_PRIVATE_KEY is accepted as an alias for SUBMITTER_SECRET, so an
# environment set up for the x402 e2e suite works unchanged.
# FACILITATOR_STELLAR_PRIVATE_KEY=S...
# Seller payTo: receives USDC, needs a USDC trustline.
# SERVER_STELLAR_ADDRESS=G...
# SELLER_SECRET=S...
# Buyer agent: signs auth entries, needs a USDC trustline AND a USDC balance.
# CLIENT_STELLAR_PRIVATE_KEY=S...

# --- Facilitator config (FACTS F-037; testnet defaults to free, RFP 3.1) ---
PORT=4021
# Whether walras charges a SERVICE fee on top of the network fee it sponsors.
# `free` is the only implemented mode; any other value is a startup error, not a fallback.
# Distinct from extra.areFeesSponsored, which is about network fees and is always true.
FEE_MODE=free
# Safety ceiling in stroops. Package default 50000; observed real fees ~23073 (FACTS F-054),
# so the default leaves only ~2x headroom. Raise deliberately, not silently.
MAX_TRANSACTION_FEE_STROOPS=50000

# --- Catalog store ---
# SQLite file backing the discovery catalog (WAL journal mode; DECISIONS D-023). The
# facilitator opens it on boot and the settle hook writes to it; the discovery endpoints
# read from it. Use ":memory:" for an ephemeral catalog.
DB_PATH=./data/catalog.db
