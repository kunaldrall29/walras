# walras — testnet configuration template.
# Copy to .env and fill in. .env is gitignored; never commit secrets, even testnet ones.
# Regenerate accounts with: node scripts/setup-accounts.mjs

# --- Network (FACTS F-004) ---
NETWORK=stellar:testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# --- Payment asset (FACTS F-052, verified on-chain) ---
# SEP-41 Soroban token contract. Classic assets are NOT supported (FACTS F-033).
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Accounts (names match the x402 e2e suite, FACTS F-056) ---
# Facilitator submitter: sponsors fees, needs XLM only, no trustline.
FACILITATOR_STELLAR_PRIVATE_KEY=S...
# Seller payTo: receives USDC, needs a USDC trustline.
SERVER_STELLAR_ADDRESS=G...
SELLER_SECRET=S...
# Buyer agent: signs auth entries, needs a USDC trustline AND a USDC balance.
CLIENT_STELLAR_PRIVATE_KEY=S...

# --- Facilitator config (FACTS F-037; testnet defaults to free, RFP 3.1) ---
PORT=4021
FEE_MODE=free
# Safety ceiling in stroops. Package default 50000; observed real fees ~23073 (FACTS F-054),
# so the default leaves only ~1.5x headroom. Raise deliberately, not silently.
MAX_TRANSACTION_FEE_STROOPS=50000

# --- Catalog store ---
DB_PATH=./data/catalog.db
